# Tushare Pro token. Needed for A-share daily data, fundamentals and money flow.
TUSHARE_TOKEN=

# Futu OpenD runs locally by default. Install and sign into OpenD separately.
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
# Futu is preferred for every A-share quote. On failure it is skipped for the
# cooldown period. A configured Hithink Finance private credential is used next,
# followed by Tencent public quotes and then Tushare daily when available.
# Do not put the Hithink key in this project file: its skill owns a private
# user-level credential store outside this repository.
FUTU_OPEND_CONNECT_TIMEOUT_SECONDS=2
A_SHARE_FUTU_TIMEOUT_SECONDS=5
A_SHARE_FUTU_COOLDOWN_SECONDS=60

# Tencent public quotes do not require a token. They are an experimental source.
TENCENT_QUOTE_TIMEOUT_SECONDS=5

# Full-market scans: A shares use Tushare's completed daily + daily_basic data;
# Hong Kong and US equities use Futu OpenD lists and snapshots in batches of <=400.
# Keep the scheduler off until manual scans and OpenD permissions are verified.
FUTU_SCAN_BATCH_SIZE=400
MARKET_SCAN_SCHEDULER_ENABLED=false
MARKET_SCAN_INTERVAL_SECONDS=900

# PostgreSQL is used to store editable personal strategy profiles.
# Example: postgresql+asyncpg://<postgres-user>@127.0.0.1:5432/my_ai_trading_agent
DATABASE_URL=

# News articles may be fetched only from explicit publisher hosts. Example:
# NEWS_ALLOWED_HOSTS=www.example.com,news.example.com
NEWS_ALLOWED_HOSTS=

# Any OpenAI Chat-Completions-compatible model endpoint. Never commit these values.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
