# Tushare Pro token. Needed for A-share daily data, money flow and news adapters.
TUSHARE_TOKEN=

# Futu OpenD runs locally by default. Install and sign into OpenD separately.
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111

# PostgreSQL is used to store editable personal strategy profiles.
# Example: postgresql+asyncpg://<postgres-user>@127.0.0.1:5432/my_ai_trading_agent
DATABASE_URL=

# News articles may be fetched only from explicit publisher hosts. Example:
# NEWS_ALLOWED_HOSTS=www.example.com,news.example.com
NEWS_ALLOWED_HOSTS=

# Any OpenAI Chat-Completions-compatible model endpoint. Never commit these values.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
